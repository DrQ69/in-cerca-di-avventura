{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://in-cerca-di-avventura.example/schemas/asset-spec.schema.json",
  "title": "ICA Asset Specification",
  "description": "Machine-readable derivative of ICA Asset Specification and Asset Dependency Map. This schema does not authorize production; only approved assets after Creative Canonical Lock may be treated as canonical production assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "role",
    "usage_class",
    "dependency_class",
    "status",
    "production_authorized",
    "usage_contexts",
    "format",
    "responsive",
    "accessibility",
    "provenance",
    "performance",
    "constraints",
    "qa_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "asset_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
    "role": {"type": "string", "minLength": 1},
    "usage_class": {"type": "string", "enum": ["SHARED_BRAND", "SHARED_UI", "PAGE_ENVIRONMENT", "CONTENT_MEDIA", "SYSTEM"]},
    "dependency_class": {"type": "string", "enum": ["REQUIRED_FOR_IMPLEMENTATION", "OPTIONAL_ENHANCEMENT", "CONTENT_GOVERNED", "LEGACY_RECHECK", "DEFERRED"]},
    "status": {"type": "string", "enum": ["planned", "concept", "candidate", "approved", "deprecated", "archived"]},
    "production_authorized": {"type": "boolean"},
    "path": {"type": ["string", "null"]},
    "planned_path": {"type": ["string", "null"]},
    "format": {"type": "string", "enum": ["svg", "webp", "avif", "png", "jpeg", "css", "system", "source-governed", "to-be-decided"]},
    "usage_contexts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_refs", "component_refs"],
      "properties": {
        "page_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "component_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "content_object_types": {"type": "array", "items": {"type": "string", "enum": ["EVENT", "PLAYER", "ORGANIZATION", "VENUE", "ARTICLE", "RESULT", "DECK", "GALLERY", "IMAGE"]}, "uniqueItems": true}
      }
    },
    "visual_spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {"type": ["string", "null"]},
        "composition": {"type": ["string", "null"]},
        "focal_point": {"type": ["string", "null"]},
        "materials": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "lighting": {"type": ["string", "null"]},
        "palette_notes": {"type": ["string", "null"]}
      }
    },
    "responsive": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "action"],
        "properties": {
          "context": {"type": "string", "enum": ["wide_desktop", "desktop", "tablet", "mobile_portrait", "mobile_landscape"]},
          "action": {"type": "string", "enum": ["PRESERVE", "CROP", "RECOMPOSE", "SIMPLIFY", "SUBSTITUTE", "REMOVE_DECORATIVE_ONLY"]},
          "safe_crop": {"type": ["string", "null"]},
          "focal_point": {"type": ["string", "null"]},
          "dedicated_variant": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "safe_area": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "horizontal": {"type": ["string", "null"]},
        "vertical": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": {"type": "string", "enum": ["decorative", "informative", "context-dependent"]},
        "usage_note": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "rights_status", "source_ref"],
      "properties": {
        "source_type": {"type": "string", "enum": ["project-original", "existing-project-asset", "content-owner", "third-party-authorized", "ai-assisted-project-original", "unknown-pending"]},
        "creator": {"type": ["string", "null"]},
        "rights_status": {"type": "string", "enum": ["confirmed", "pending", "source-governed", "not-applicable", "blocked"]},
        "generation_method": {"type": ["string", "null"]},
        "source_ref": {"type": "string", "minLength": 1},
        "credit": {"type": ["string", "null"]}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_category"],
      "properties": {
        "budget_category": {"type": "string", "enum": ["icon", "ornament", "raster-button", "sigil-logo", "card-content-artwork", "section-banner", "desktop-hero", "mobile-hero", "content-source", "not-applicable"]},
        "target_kb": {"type": ["integer", "null"], "minimum": 0},
        "max_kb": {"type": ["integer", "null"], "minimum": 0},
        "exception_ref": {"type": ["string", "null"]}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "negative_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "canonical_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "qa_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {"production_authorized": {"const": true}, "path": {"type": "string", "minLength": 1}},
        "required": ["path"]
      }
    },
    {
      "if": {"properties": {"dependency_class": {"const": "LEGACY_RECHECK"}}, "required": ["dependency_class"]},
      "then": {"properties": {"production_authorized": {"const": false}}}
    },
    {
      "if": {"properties": {"dependency_class": {"const": "DEFERRED"}}, "required": ["dependency_class"]},
      "then": {"properties": {"production_authorized": {"const": false}}}
    }
  ]
}
